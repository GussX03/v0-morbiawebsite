# Google Reviews para Morbia. No publiques estos valores ni los agregues con NEXT_PUBLIC_.
SERPAPI_API_KEY=
MORBIA_GOOGLE_MAPS_DATA_ID=0xaaa0000f18d746cf:0x95d6e124df4644ed
MORBIA_GOOGLE_MAPS_SHARE_URL=https://www.google.com/maps/place/Morbia/@19.0400474,-98.1921822,12z/data=!3m1!4b1!4m6!3m5!1s0xaaa0000f18d746cf:0x95d6e124df4644ed!8m2!3d19.0400474!4d-98.1921822!16s%2Fg%2F11n3ppxs3r?entry=ttu
MORBIA_GOOGLE_MAPS_PROVIDER_ID=/g/11n3ppxs3r

# Chat de Morbia. Este valor es sólo del servidor; en producción se configura en Vercel.
N8N_CHAT_WEBHOOK_URL=

# Migración opcional del chat a OpenAI. Mantener el proveedor vacío hasta verificar la integración.
MORBIA_CHAT_PROVIDER=
OPENAI_API_KEY=
MORBIA_OPENAI_AGENT_ID=
MORBIA_CHAT_COOKIE_SECRET=
MORBIA_CHAT_SESSION_LIMIT_CENTS=
MORBIA_CHAT_TRAFFIC_CONTROL_ENABLED=
MORBIA_CHAT_PREVIEW_ORIGIN=

# Credenciales de servidor del puente con Google Calendar; nunca usar NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
MORBIA_CALENDAR_MCP_SECRET=
